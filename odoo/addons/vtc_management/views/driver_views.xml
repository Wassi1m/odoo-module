<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vtc_driver_tree" model="ir.ui.view">
        <field name="name">vtc.driver.tree</field>
        <field name="model">vtc.driver</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="ride_count"/>
                <field name="rating"/>
                <field name="total_revenue"/>
                <field name="driver_earnings"/>
                <field name="state" widget="badge" decoration-success="state == 'online'"
                       decoration-danger="state == 'suspended'"/>
            </list>
        </field>
    </record>

    <record id="vtc_driver_form" model="ir.ui.view">
        <field name="name">vtc.driver.form</field>
        <field name="model">vtc.driver</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_go_online" type="object" string="Mettre en ligne"
                            class="btn-primary" invisible="state == 'online'"/>
                    <button name="action_go_offline" type="object" string="Mettre hors ligne"
                            invisible="state != 'online'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="license_number"/>
                            <field name="license_expiry"/>
                        </group>
                        <group>
                            <field name="commission_rate"/>
                            <field name="ride_count"/>
                            <field name="rating"/>
                            <field name="total_revenue"/>
                            <field name="driver_earnings"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Véhicules">
                            <field name="vehicle_ids"/>
                        </page>
                        <page string="Courses">
                            <field name="ride_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="client_id"/>
                                    <field name="request_date"/>
                                    <field name="price" sum="Total"/>
                                    <field name="rating"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vtc_driver_search" model="ir.ui.view">
        <field name="name">vtc.driver.search</field>
        <field name="model">vtc.driver</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <filter name="online" string="En ligne" domain="[('state','=','online')]"/>
            </search>
        </field>
    </record>

    <record id="action_vtc_driver" model="ir.actions.act_window">
        <field name="name">Chauffeurs</field>
        <field name="res_model">vtc.driver</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
