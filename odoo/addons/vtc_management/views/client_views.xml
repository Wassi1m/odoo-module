<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vtc_client_tree" model="ir.ui.view">
        <field name="name">vtc.client.tree</field>
        <field name="model">vtc.client</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="ride_count"/>
                <field name="total_spent"/>
            </list>
        </field>
    </record>

    <record id="vtc_client_form" model="ir.ui.view">
        <field name="name">vtc.client.form</field>
        <field name="model">vtc.client</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="favorite_address"/>
                        </group>
                        <group>
                            <field name="ride_count"/>
                            <field name="total_spent"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Courses">
                            <field name="ride_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="pickup"/>
                                    <field name="destination"/>
                                    <field name="driver_id"/>
                                    <field name="price" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_vtc_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">vtc.client</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
